# 本项目专属数据在 %LOCALAPPDATA%\dsh-bilibili-companion\（不在仓库内），
# 这里兜底忽略可能被误建在仓库内的运行时产物。
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 运行时数据与凭据 —— 绝不进 git
data/
.local-data/
*.db
*.db-wal
*.db-shm
companion.log
*.lock

# 真实配置（含本机 UID / 密钥环境变量名），只提交 config.example.yaml
config.yaml

# 上游参考源码（按决策不 vendor；若将来 vendor 需先解决 GPL）
third_party/*
!third_party/README.md

# 本地调试残留（不应提交）
workspace-probe*/
tmp*/
pytest-of-*/

# ★ 第三方设计资产（2026-10-17）：25 款字体 57MB，不该进 git。
#   来源见 design/README.md；需要时按文档重新提取。
design/fonts/
design/multiplane/*.mp4
design/multiplane/*.png
design/multiplane/fonts/

# 插件打包产物
plugin/*.tgz
plugin/node_modules/

# 探针/临时脚本产物
probe_tmp.py
